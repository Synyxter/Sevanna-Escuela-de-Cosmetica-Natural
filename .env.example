# ==========================================================================
# Sevanna Backend — Environment variables example
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# ==========================================================================

# --- Application ---
APP_ENV=development                 # development | testing | staging | production
APP_NAME=Sevanna API
APP_DEBUG=true
LOG_LEVEL=INFO

# --- Server ---
HOST=0.0.0.0
PORT=8000

# --- Database (PostgreSQL) ---
# Async driver is required (asyncpg).
DATABASE_URL=postgresql+asyncpg://sevanna:sevanna@localhost:5432/sevanna

# --- JWT / Auth ---
# Generate a strong secret, e.g.:  python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=change-me-to-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30
EMAIL_VERIFICATION_TOKEN_EXPIRE_HOURS=48

# --- CORS (comma-separated list of allowed frontend origins) ---
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Docs exposure in production ---
ENABLE_DOCS=true

# --- Feature flags ---
# Sevanna funciona como catálogo de cursos: inscripción y pago se gestionan por
# WhatsApp (fuera del backend). Estos módulos quedan desactivados por defecto;
# su código se conserva y se reactiva poniendo la flag en true.
#   ENABLE_ACCOUNTS -> cuentas de estudiante (registro, perfil, /users/me...)
#   ENABLE_COMMERCE -> compras, pagos (webhook) e inscripciones
ENABLE_ACCOUNTS=false
ENABLE_COMMERCE=false

# --- Payment provider ---
PAYMENT_PROVIDER=wompi               # wompi | fake
PAYMENT_API_KEY=                     # Wompi private key (prv_...)
PAYMENT_PUBLIC_KEY=                  # Wompi public key (pub_...)
PAYMENT_WEBHOOK_SECRET=              # Wompi events secret (webhook signature validation)
PAYMENT_INTEGRITY_SECRET=           # Wompi integrity secret (checkout URL signature)
PAYMENT_BASE_URL=https://sandbox.wompi.co/v1
PAYMENT_CHECKOUT_URL=https://checkout.wompi.co/p/
PAYMENT_CURRENCY=COP
PAYMENT_REDIRECT_URL=http://localhost:5173/checkout/result

# --- Email provider ---
EMAIL_PROVIDER=console               # smtp | console
EMAIL_FROM=no-reply@sevanna.co
EMAIL_FROM_NAME=Sevanna
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true

# --- Storage provider ---
STORAGE_PROVIDER=local               # local | (s3/cloudinary later)
STORAGE_LOCAL_DIR=./media
STORAGE_PUBLIC_BASE_URL=http://localhost:8000/media

# --- First admin bootstrap (used by scripts/seed) ---
FIRST_ADMIN_EMAIL=admin@sevanna.co
FIRST_ADMIN_PASSWORD=ChangeMe123!
FIRST_ADMIN_NAME=Administrador Sevanna

# --- Rate limiting ---
RATE_LIMIT_ENABLED=true
